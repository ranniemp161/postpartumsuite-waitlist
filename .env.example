# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# See the "Google Sheet setup" section of README.md for where these come from.

# The segment of the sheet URL between /d/ and /edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# The service account's client_email, ends in .gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private_key, copied from the downloaded JSON key.
# Keep it on one line, in double quotes, with the \n sequences left literal
# exactly as they appear in the JSON. saveSignup() turns them back into real
# newlines at runtime. Unquoting it or hand-wrapping the lines breaks auth with
# an error that does not mention formatting.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. The sheet tab signups are appended to. Defaults to Signups.
# Set it to a test tab (for example Signups-Test) on Preview and local only, so
# trial signups never land in the real tab. Leave it unset on Production.
GOOGLE_SHEETS_TAB=

# Optional. The Zoho CRM function URL each saved signup is POSTed to. It contains
# an API key, so treat it as a secret: never commit it, never log it. When it is
# unset the Zoho step is skipped entirely. Use the Zoho sandbox URL on Preview and
# local, and add the live URL to Production only once the client has confirmed
# the sandbox lead looks right.
ZOHO_WAITLIST_URL=
